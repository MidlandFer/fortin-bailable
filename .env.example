NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
TZ=America/Argentina/Buenos_Aires

DATABASE_URL=postgres://fortin:fortin@localhost:5432/fortin_bailable

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Número público del bot en formato wa.me (solo dígitos, con código de país, sin
# "+"), usado para armar el link "click to chat" que se codifica en el QR de
# cada entrada (así al escanearlo con la cámara se abre WhatsApp directo con el
# bot y el código ya cargado, listo para enviar). Si se deja vacío, el QR
# codifica el payload en texto plano (hay que pegarlo a mano en el chat del bot).
WHATSAPP_BOT_PHONE_NUMBER=

# Números de WhatsApp de los verificadores de puerta (separados por coma), en el
# mismo formato en que llegan en "message.from" del webhook: solo dígitos, con
# código de país, sin "+" ni espacios (ej: 5492284155555). Cuando uno de estos
# números escribe al bot, el texto se trata como un código de QR escaneado en
# la entrada en vez de como un mensaje de compra.
VERIFIER_PHONE_NUMBERS=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_ALIAS=fortin.baile

QR_SIGNING_SECRET=
SESSION_SECRET=
JWT_SECRET=
ADMIN_SEED_EMAIL=admin@fortinbailable.com
ADMIN_SEED_PASSWORD=changeme

RESERVATION_TTL_MINUTES=5
PAYMENT_MATCH_WINDOW_MINUTES=45
AMOUNT_DISTINGUISHING_STEP=0.01
REPORT_ADMIN_SESSION_IDLE_MINUTES=15

# Contraseñas para los 3 números de WhatsApp habilitados como admins de
# reportes de venta (ver scripts/seedReportAdmins.ts). Solo se usan una vez,
# al correr `npm run seed:report-admins`: quedan guardadas hasheadas en la
# base y después se pueden borrar de acá.
REPORT_ADMIN_PASSWORD_1=
REPORT_ADMIN_PASSWORD_2=
REPORT_ADMIN_PASSWORD_3=

LOG_LEVEL=info
