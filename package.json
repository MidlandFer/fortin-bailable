{
  "name": "fortin-bailable",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp para venta de entradas, control de acceso por QR y reportes para Fortín Bailable",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node-pg-migrate --migrations-dir src/db/migrations --migration-file-language sql",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --migration-file-language sql",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --migration-file-language sql",
    "seed:admin": "tsx scripts/seedAdmin.ts",
    "seed:report-admins": "tsx scripts/seedReportAdmins.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "form-data": "^4.0.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mercadopago": "^2.3.0",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true
  }
}
